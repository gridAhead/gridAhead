---
import Chevron from "../components/Chevron.astro";
import Logo from "../components/Logo.astro";
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  page={{
    title: "gridAhead — Grid expansion plans, on a map",
    description: config.description,
    route: "/",
  }}
>
  <section class="pt-16 pb-16 sm:pt-24 sm:pb-20">
    <div class="mx-auto max-w-[1400px] px-6">
      <p class="m-0 text-muted-foreground text-xs">
        Reiner Lemoine Institute & Goal100
      </p>
      <h1
        class="mt-6 mb-0 max-w-3xl text-balance font-medium text-4xl leading-none sm:text-5xl lg:text-6xl"
      >
        <span class="block">Grid expansion plans,</span>
        <span class="block">geocoded and mapped.</span>
        <span class="block text-muted-foreground">Open to the public.</span>
      </h1>
      <p class="mt-8 mb-0 max-w-xl text-pretty text-lg text-muted-foreground">
        Larger German distribution system operators publish their grid
        expansion plans every two years. The documents exist, just not in a
        form anyone can work with. gridAhead geocodes and georeferences them
        so the public can use them.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          class="inline-flex items-center gap-1 font-medium text-accent text-sm hover:text-foreground"
          href="/docs"
        >
          Read the docs
          <Chevron />
        </a>
        <a
          class="inline-flex items-center gap-1 font-medium text-accent text-sm hover:text-foreground"
          href="/blog/2026-11-15-introducing-gridahead"
        >
          Our announcement
          <Chevron />
        </a>
      </div>
    </div>

    <div class="mx-auto mt-16 max-w-[1400px] px-6 sm:mt-20">
      <div class="hero-bloom overflow-hidden rounded-[28px] px-3 pt-8 sm:px-16 sm:pt-16">
        <figure class="preview-window m-0 overflow-hidden rounded-t-2xl bg-background">
          <figcaption class="sr-only">
            A schematic of an existing grid and a planned expansion. Not a
            network plan.
          </figcaption>
          <div class="grid h-[420px] sm:h-[520px] sm:grid-cols-[220px_minmax(0,1fr)]">
            <aside class="hidden border-border border-r px-4 py-5 sm:block">
              <ul class="mt-3 list-none p-0 text-sm">
                <li class="flex items-center gap-2 py-1.5">
                  <span class="inline-block h-px w-4 bg-foreground/70"></span>
                  Existing grid
                </li>
                <li class="flex items-center gap-2 py-1.5 text-accent">
                  <span class="inline-block h-px w-4 border-accent border-t border-dashed"></span>
                  Planned expansion
                </li>
              </ul>
            </aside>
            <div class="map-pane min-h-0 p-4 text-foreground sm:p-8">
              <svg
                aria-hidden="true"
                class="h-full w-full"
                fill="none"
                viewBox="24 40 560 350"
              >
                <path
                  d="M48 64H220V176H404"
                  stroke="currentColor"
                  stroke-opacity="0.72"
                  stroke-width="1.6"
                />
                <path
                  d="M220 176V308H112"
                  stroke="currentColor"
                  stroke-opacity="0.4"
                  stroke-width="1.6"
                />
                <path
                  d="M404 176V96H548"
                  stroke="currentColor"
                  stroke-opacity="0.4"
                  stroke-width="1.6"
                />
                <path
                  d="M328 176V260H452"
                  stroke="currentColor"
                  stroke-opacity="0.4"
                  stroke-width="1.6"
                />
                <path
                  class="text-accent"
                  d="M404 176H536V292"
                  stroke="currentColor"
                  stroke-dasharray="5 5"
                  stroke-width="1.6"
                />
                <path
                  class="text-accent"
                  d="M220 308H372V372"
                  stroke="currentColor"
                  stroke-dasharray="5 5"
                  stroke-width="1.6"
                />
                <rect
                  class="text-accent"
                  height="20"
                  stroke="currentColor"
                  stroke-width="1.6"
                  width="20"
                  x="38"
                  y="54"
                />
                <circle
                  cx="220"
                  cy="176"
                  r="5"
                  stroke="currentColor"
                  stroke-opacity="0.85"
                  stroke-width="1.6"
                />
                <circle
                  cx="404"
                  cy="176"
                  r="5"
                  stroke="currentColor"
                  stroke-opacity="0.85"
                  stroke-width="1.6"
                />
                <circle
                  cx="112"
                  cy="308"
                  r="4"
                  stroke="currentColor"
                  stroke-opacity="0.5"
                  stroke-width="1.6"
                />
                <circle
                  cx="548"
                  cy="96"
                  r="4"
                  stroke="currentColor"
                  stroke-opacity="0.5"
                  stroke-width="1.6"
                />
                <circle
                  cx="452"
                  cy="260"
                  r="4"
                  stroke="currentColor"
                  stroke-opacity="0.5"
                  stroke-width="1.6"
                />
                <circle class="text-accent" cx="536" cy="292" fill="currentColor" r="5" />
                <circle class="text-accent" cx="372" cy="372" fill="currentColor" r="5" />
              </svg>
            </div>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section class="border-border border-t">
    <div class="mx-auto max-w-[1400px] px-6 py-20 sm:py-28">
      <h2 class="mt-0 mb-0 max-w-3xl font-medium text-3xl leading-none sm:text-4xl">
        <span class="block">Published every two years.</span>
        <span class="block text-muted-foreground">Still barely usable as data.</span>
      </h2>
      <p class="mt-8 mb-0 max-w-xl text-pretty text-lg text-muted-foreground">
        Grid expansion decides where the energy transition becomes practical.
        The plans that describe it are public. They follow no modern data
        standard, and broad demands on the Federal Network Agency have not
        changed that.
      </p>
      <dl class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
        <div class="border-border border-t pt-5">
          <dt class="font-medium text-xl">Every two years</dt>
          <dd class="mt-2 mb-0 text-muted-foreground leading-relaxed">
            Larger distribution system operators have to publish their grid
            expansion plans on this cycle.
          </dd>
        </div>
        <div class="border-border border-t pt-5">
          <dt class="font-medium text-xl">No data standard</dt>
          <dd class="mt-2 mb-0 text-muted-foreground leading-relaxed">
            The publications cannot readily be reused, compared, or placed on
            a map.
          </dd>
        </div>
        <div class="border-border border-t pt-5">
          <dt class="font-medium text-xl">Public interest</dt>
          <dd class="mt-2 mb-0 text-muted-foreground leading-relaxed">
            Investment, research, and policy debates need the same facts,
            spatially and traceably.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="border-border border-t">
    <div class="mx-auto max-w-[1400px] px-6 py-20 sm:py-28">
      <h2 class="mt-0 mb-0 max-w-3xl font-medium text-3xl leading-none sm:text-4xl">
        <span class="block">From documents to places.</span>
        <span class="block text-muted-foreground">What gridAhead is building.</span>
      </h2>
      <ol class="mt-16 grid list-none gap-px overflow-hidden rounded-2xl border border-border bg-border p-0 md:grid-cols-3">
        <li class="bg-background px-6 py-8">
          <p class="m-0 font-mono text-muted-foreground text-xs">01</p>
          <h3 class="mt-4 mb-0 font-medium text-xl">Geocode</h3>
          <p class="mt-3 mb-0 text-muted-foreground leading-relaxed">
            Bind places and measures in the plans PDF's to coordinates.
          </p>
        </li>
        <li class="bg-background px-6 py-8">
          <p class="m-0 font-mono text-muted-foreground text-xs">02</p>
          <h3 class="mt-4 mb-0 font-medium text-xl">Georeference</h3>
          <p class="mt-3 mb-0 text-muted-foreground leading-relaxed">
            Create the most comprehensive public data of current and future medium voltage grids in Germany.
          </p>
        </li>
        <li class="bg-background px-6 py-8">
          <p class="m-0 font-mono text-muted-foreground text-xs">03</p>
          <h3 class="mt-4 mb-0 font-medium text-xl">Make it accessible</h3>
          <p class="mt-3 mb-0 text-muted-foreground leading-relaxed">
            Publish the result so others can keep working with it.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="border-border border-t">
    <div class="mx-auto max-w-[1400px] px-6 py-16 sm:py-24">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="m-0 text-muted-foreground text-xs">Cooperation</p>
          <p class="mt-4 mb-0 max-w-xl font-medium text-3xl leading-none sm:text-4xl">
            A cooperation of the Reiner Lemoine Institute and Goal100.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-x-12 gap-y-8">
            <Logo
              alt="Reiner Lemoine Institut"
              class="h-11"
              href="https://reiner-lemoine-institut.de/"
              src="/logos/reiner-lemoine-institut.svg"
              srcDark="/logos/reiner-lemoine-institut-inverse.svg"
            />
            <Logo
              alt="Goal100"
              class="h-14"
              href="https://goal100.org/"
              src="/logos/goal100.svg"
              srcDark="/logos/goal100-inverse.svg"
            />
          </div>
        </div>
        <a
          class="inline-flex shrink-0 items-center gap-1 font-medium text-accent text-sm hover:text-foreground"
          href="/docs"
        >
          Read the introduction
          <Chevron />
        </a>
      </div>
      <div class="mt-16 border-border border-t pt-10">
        <p class="m-0 text-muted-foreground text-xs">Co-funded by</p>
        <div class="mt-6 flex flex-wrap items-start gap-x-12 gap-y-8">
          <Logo
            alt="Google.org"
            class="h-6"
            href="https://www.google.org/"
            src="/logos/google-org.svg"
            srcDark="/logos/google-org-inverse.svg"
          />
          <Logo
            alt="Veolia Stiftung"
            caption="Veolia Stiftung"
            class="h-7"
            href="https://www.stiftung.veolia.de/"
            src="/logos/veolia-stiftung.png"
          />
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .hero-bloom {
    background-color: color-mix(in oklab, var(--blume-accent) 12%, var(--blume-background));
    background-image:
      radial-gradient(
        70% 60% at 50% 100%,
        color-mix(in oklab, var(--blume-accent) 72%, transparent),
        transparent 75%
      ),
      radial-gradient(
        120% 90% at 50% 100%,
        color-mix(in oklab, var(--blume-accent) 32%, transparent),
        transparent 80%
      );
  }

  .preview-window {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--blume-foreground) 6%, transparent),
      0 32px 80px -24px color-mix(in oklab, var(--blume-accent) 35%, transparent);
  }

  .map-pane {
    background-image:
      linear-gradient(
        to right,
        color-mix(in oklab, var(--blume-foreground) 7%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in oklab, var(--blume-foreground) 7%, transparent) 1px,
        transparent 1px
      );
    background-size: 48px 48px;
  }
</style>
