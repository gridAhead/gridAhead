---
import Chevron from "../components/Chevron.astro";
import Logo from "../components/Logo.astro";
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

const { config } = data;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  page={{
    title: "gridAhead — Turning grid plans into data",
    description: config.description,
    route: "/",
  }}
>
  <section class="pt-16 pb-16 sm:pt-24 sm:pb-20">
    <div class="mx-auto max-w-[1400px] px-6">
      <p class="m-0 text-muted-foreground text-xs">
        Reiner Lemoine Institute & Goal100
      </p>
      <h1
        class="mt-6 mb-0 max-w-3xl text-balance font-medium text-4xl leading-none sm:text-5xl lg:text-6xl"
      >
        <span class="block">Turning grid plans</span>
        <span class="block">into data.</span>
        <span class="block text-muted-foreground">Open and georeferenced.</span>
      </h1>
      <p class="mt-8 mb-0 max-w-xl text-pretty text-lg text-muted-foreground">
        Since the end of October, Germany's larger distribution system
        operators have published a second round of grid expansion plans, more
        than 33,000 measures. The data is still hard to use. gridAhead turns
        those published plans into open, georeferenced datasets.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          class="inline-flex items-center gap-1 font-medium text-accent text-sm hover:text-foreground"
          href="/docs"
        >
          Read the docs
          <Chevron />
        </a>
        <a
          class="inline-flex items-center gap-1 font-medium text-accent text-sm hover:text-foreground"
          href="/blog/2026-11-17-introducing-gridahead"
        >
          Our announcement
          <Chevron />
        </a>
      </div>
    </div>

    <div class="mx-auto mt-16 max-w-[1400px] px-6 sm:mt-20">
      <div class="hero-bloom overflow-hidden rounded-[28px] px-3 pt-8 sm:px-16 sm:pt-16">
        <figure class="preview-window m-0 overflow-hidden rounded-t-2xl bg-background">
          <img
            alt="Stylized map of Germany: hexagons shaded by the density of grid expansion measures, overlaid with a schematic grid of existing and planned lines and substations."
            class="block h-auto w-full"
            decoding="async"
            height="727"
            src="/images/landing-map.png"
            width="1600"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="border-border border-t">
    <div class="mx-auto max-w-[1400px] px-6 py-20 sm:py-28">
      <h2 class="mt-0 mb-0 max-w-3xl font-medium text-3xl leading-none sm:text-4xl">
        <span class="block">Over 33,000 measures.</span>
        <span class="block text-muted-foreground">Still hard to use as data.</span>
      </h2>
      <p class="mt-8 mb-0 max-w-xl text-pretty text-lg text-muted-foreground">
        New wind and solar plants, storage, heat pumps, and charging points
        can connect only as fast as the distribution grid is reinforced. The
        plans for that work are public. Places, coordinates, and open licences
        are mostly still missing.
      </p>
      <dl class="mt-16 grid gap-12 md:grid-cols-3 md:gap-8">
        <div class="border-border border-t pt-5">
          <dt class="font-medium text-xl">Second round, 2026</dt>
          <dd class="mt-2 mb-0 text-muted-foreground leading-relaxed">
            80 of 85 operators have published measures. About 20,000 of the
            more than 33,000 are ongoing or planned. Where they are is still
            generally unclear.
          </dd>
        </div>
        <div class="border-border border-t pt-5">
          <dt class="font-medium text-xl">Spreadsheets, not maps</dt>
          <dd class="mt-2 mb-0 text-muted-foreground leading-relaxed">
            Most operators now use a common spreadsheet format. The 2024 round
            was PDF only. Measures still have no coordinates, and the grid
            maps are still images in the reports.
          </dd>
        </div>
        <div class="border-border border-t pt-5">
          <dt class="font-medium text-xl">Every two years</dt>
          <dd class="mt-2 mb-0 text-muted-foreground leading-relaxed">
            Operators with 100,000 or more customers, and smaller ones with
            significant wind or solar curtailment, must publish a plan on
            VNBdigital under §§ 14d and 14e EnWG.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="border-border border-t">
    <div class="mx-auto max-w-[1400px] px-6 py-20 sm:py-28">
      <h2 class="mt-0 mb-0 max-w-3xl font-medium text-3xl leading-none sm:text-4xl">
        <span class="block">From published plans to open data.</span>
        <span class="block text-muted-foreground">What gridAhead is building.</span>
      </h2>
      <ol class="mt-16 grid list-none gap-px overflow-hidden rounded-2xl border border-border bg-border p-0 md:grid-cols-2">
        <li class="bg-background px-6 py-8">
          <p class="m-0 font-mono text-muted-foreground text-xs">01</p>
          <h3 class="mt-4 mb-0 font-medium text-xl">Geocode planned measures</h3>
          <p class="mt-3 mb-0 text-muted-foreground leading-relaxed">
            Locate announced measures from the 2024 and 2026 plans, so it is
            clear where and when the grid near a site will be reinforced.
          </p>
        </li>
        <li class="bg-background px-6 py-8">
          <p class="m-0 font-mono text-muted-foreground text-xs">02</p>
          <h3 class="mt-4 mb-0 font-medium text-xl">Georeference grid maps</h3>
          <p class="mt-3 mb-0 text-muted-foreground leading-relaxed">
            Digitize the maps in the plans and enrich them with other public
            data. Studies can then use real medium-voltage topologies instead
            of synthetic model grids.
          </p>
        </li>
        <li class="bg-background px-6 py-8">
          <p class="m-0 font-mono text-muted-foreground text-xs">03</p>
          <h3 class="mt-4 mb-0 font-medium text-xl">Make it accessible</h3>
          <p class="mt-3 mb-0 text-muted-foreground leading-relaxed">
            Publish results under open licences whenever possible, so others
            can reuse one versioned dataset instead of starting from the
            original documents again.
          </p>
        </li>
        <li class="bg-background px-6 py-8">
          <p class="m-0 font-mono text-muted-foreground text-xs">04</p>
          <h3 class="mt-4 mb-0 font-medium text-xl">Build a community</h3>
          <p class="mt-3 mb-0 text-muted-foreground leading-relaxed">
            An open community that uses, reviews, and develops the data and
            the methods.
            <a
              class="text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground"
              href="https://github.com/gridahead/gridahead"
            >
              Help on GitHub.
            </a>
          </p>
        </li>
      </ol>
      <p class="mt-10 mb-0 max-w-xl text-muted-foreground leading-relaxed">
        Making these plans easier to use does not conflict with the protection
        of critical infrastructure. gridAhead works only with information
        distribution system operators have already published.
      </p>
    </div>
  </section>

  <section class="border-border border-t">
    <div class="mx-auto max-w-[1400px] px-6 py-16 sm:py-24">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="m-0 text-muted-foreground text-xs">Cooperation</p>
          <p class="mt-4 mb-0 max-w-xl font-medium text-3xl leading-none sm:text-4xl">
            A cooperation of the Reiner Lemoine Institute and Goal100.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-x-12 gap-y-8">
            <Logo
              alt="Reiner Lemoine Institut"
              class="h-11"
              href="https://reiner-lemoine-institut.de/"
              src="/logos/reiner-lemoine-institut.svg"
              srcDark="/logos/reiner-lemoine-institut-inverse.svg"
            />
            <Logo
              alt="Goal100"
              class="h-14"
              href="https://goal100.org/"
              src="/logos/goal100.svg"
              srcDark="/logos/goal100-inverse.svg"
            />
          </div>
        </div>
        <a
          class="inline-flex shrink-0 items-center gap-1 font-medium text-accent text-sm hover:text-foreground"
          href="/docs"
        >
          Read the introduction
          <Chevron />
        </a>
      </div>
      <div class="mt-16 border-border border-t pt-10">
        <p class="m-0 text-muted-foreground text-xs">Funded by</p>
        <p class="mt-4 mb-0 max-w-xl text-muted-foreground leading-relaxed">
          Goal100's initiative for gridAhead is jointly funded by Google.org
          and the Veolia Stiftung, and hosted by <a
            class="text-foreground underline decoration-border underline-offset-4 hover:decoration-foreground"
            href="https://projecttogether.org/"
          >ProjectTogether</a>.
        </p>
        <div class="mt-6 flex flex-wrap items-start gap-x-12 gap-y-8">
          <Logo
            alt="Google.org"
            class="h-6"
            href="https://www.google.org/"
            src="/logos/google-org.svg"
            srcDark="/logos/google-org-inverse.svg"
          />
          <Logo
            alt="Veolia Stiftung"
            caption="Veolia Stiftung"
            class="h-7"
            href="https://www.stiftung.veolia.de/"
            src="/logos/veolia-stiftung.png"
          />
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* gridAhead logo green */
  .hero-bloom,
  .preview-window {
    --ga-green: #00c46a;
  }

  .hero-bloom {
    background-color: color-mix(in oklab, var(--ga-green) 12%, var(--blume-background));
    background-image:
      radial-gradient(
        70% 60% at 50% 100%,
        color-mix(in oklab, var(--ga-green) 72%, transparent),
        transparent 75%
      ),
      radial-gradient(
        120% 90% at 50% 100%,
        color-mix(in oklab, var(--ga-green) 32%, transparent),
        transparent 80%
      );
  }

  .preview-window {
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--blume-foreground) 6%, transparent),
      0 32px 80px -24px color-mix(in oklab, var(--ga-green) 35%, transparent);
  }
</style>
