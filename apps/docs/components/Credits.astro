---
import Logo from "./Logo.astro";
---

<div class="not-prose mt-12 border-border border-t pt-8">
  <p class="m-0 text-muted-foreground text-xs">Cooperation</p>
  <div class="mt-5 flex flex-wrap items-center gap-x-10 gap-y-6">
    <Logo
      alt="Reiner Lemoine Institut"
      class="h-10"
      href="https://reiner-lemoine-institut.de/"
      src="/logos/reiner-lemoine-institut.svg"
      srcDark="/logos/reiner-lemoine-institut-inverse.svg"
    />
    <Logo
      alt="Goal100"
      class="h-12"
      href="https://goal100.org/"
      src="/logos/goal100.svg"
      srcDark="/logos/goal100-inverse.svg"
    />
  </div>
  <p class="mt-14 mb-0 text-muted-foreground text-xs">Goal100's initiative in this project is hosted by ProjectTogether gGmbH and co-funded by</p>
  <div class="mt-5 flex flex-wrap items-start gap-x-10 gap-y-6">
    <Logo
      alt="Veolia Stiftung"
      caption="Veolia Stiftung"
      class="h-6"
      href="https://www.stiftung.veolia.de/"
      src="/logos/veolia-stiftung.png"
    />
  </div>
</div>
