---
import { getCollection } from "astro:content";
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";
import { getBlumeCollection } from "blume/runtime";
import type { SiteLocale } from "../lib/locale.ts";
import { localeSwitch, navigationFor, uiFor } from "../lib/locale.ts";
import Chevron from "./Chevron.astro";

interface Props {
  locale: SiteLocale;
}

const { locale } = Astro.props;

// Each locale's index lists that locale's posts. getBlumeCollection leaves
// out drafts, hidden pages, and the copies i18n serves for untranslated
// pages, so a post appears here once it has a real translation.
const routes = getBlumeCollection(data, { locale });
const routeByEntry = new Map(routes.map((route) => [route.entryId, route.path]));

const posts = (await getCollection("docs"))
  .filter((entry) => entry.data.type === "blog" && routeByEntry.has(entry.id))
  .map((entry) => ({
    date: entry.data.date,
    description: entry.data.description,
    href: routeByEntry.get(entry.id) ?? "/blog",
    title: entry.data.title,
  }))
  .toSorted((a, b) => Number(new Date(b.date ?? 0)) - Number(new Date(a.date ?? 0)));

const { config } = data;
const route = locale === config.i18n?.defaultLocale ? "/blog" : `/${locale}/blog`;
const dateLocale = locale === "de" ? "de-DE" : "en-US";

const copy = {
  de: {
    description: "Ankündigungen und Notizen von gridAhead.",
    empty: "Noch keine Beiträge.",
    read: "Lesen",
    subtitle: "Ankündigungen und Notizen",
    title: "Blog — gridAhead",
  },
  en: {
    description: "Announcements and notes from gridAhead.",
    empty: "No posts yet.",
    read: "Read",
    subtitle: "Our announcements and notes",
    title: "Blog — gridAhead",
  },
}[locale];

const formatDate = (date: Date | string | undefined): string => {
  if (!date) {
    return "";
  }
  return new Intl.DateTimeFormat(dateLocale, {
    day: "numeric",
    month: "long",
    timeZone: "UTC",
    year: "numeric",
  }).format(new Date(date));
};
---

<PageLayout
  site={{ title: config.title, description: copy.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={navigationFor(data, locale)}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  structuredDataEnabled={config.structuredData}
  lastModified={posts[0]?.date}
  locale={locale}
  ui={uiFor(data, locale)}
  localeSwitch={localeSwitch(data, locale, "/blog")}
  page={{
    title: copy.title,
    description: copy.description,
    route,
  }}
>
  <section class="pt-16 pb-24 sm:pt-24">
    <div class="mx-auto max-w-[1400px] px-6">
      <p class="m-0 text-muted-foreground text-xs">gridAhead</p>
      <h1 class="mt-6 mb-0 max-w-3xl font-medium text-4xl leading-none sm:text-5xl">
        <span class="block">Blog</span>
        <span class="block text-muted-foreground">{copy.subtitle}</span>
      </h1>
      {
        posts.length === 0 ? (
          <p class="mt-8 mb-0 max-w-xl text-muted-foreground">{copy.empty}</p>
        ) : (
          <ul class="mt-16 mb-0 list-none divide-y divide-border border-border border-y p-0">
            {posts.map((post) => (
              <li>
                <a class="group block py-8 sm:py-10" href={post.href}>
                  {post.date && (
                    <time
                      class="text-muted-foreground text-xs"
                      datetime={new Date(post.date).toISOString().slice(0, 10)}
                    >
                      {formatDate(post.date)}
                    </time>
                  )}
                  <span class="mt-3 block font-medium text-2xl leading-none sm:text-3xl">
                    {post.title}
                  </span>
                  {post.description && (
                    <span class="mt-4 block max-w-xl text-muted-foreground">
                      {post.description}
                    </span>
                  )}
                  <span class="mt-5 inline-flex items-center gap-1 font-medium text-accent text-sm group-hover:text-foreground">
                    {copy.read}
                    <Chevron />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</PageLayout>
